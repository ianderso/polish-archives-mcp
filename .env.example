# Copy to .env to change a default. Nothing here is required: Geneteka, the
# Poznań Project, BaSIA and Szukaj w Archiwach's photo host need no key and no
# account.
#
# The server reads .env from the directory it is started in -- the
# repository root, when launched with `uv --directory /path/to/polish-archives-mcp`.
# Variables already set in the environment take precedence.

# Optional: an email address or URL added to the User-Agent, so a site can
# reach you if your use ever causes it trouble.
# POLISH_ARCHIVES_CONTACT=you@example.org

# Optional: directory for the on-disk response cache.
# POLISH_ARCHIVES_CACHE_DIR=~/.cache/polish-archives-mcp

# Optional: HTTP timeout in seconds for one request (default 60; scan
# downloads get 180 to read).
# POLISH_ARCHIVES_TIMEOUT=60

# Optional: least seconds between two requests to one site (default 4, never
# below 4; BaSIA always gets at least 10).
# POLISH_ARCHIVES_MIN_INTERVAL=4

# Optional: an existing folder that every swa_scan destination must lie
# inside. swa_scan never writes under ~/Library otherwise; set this to save
# into an iCloud Drive folder, which lives there.
# POLISH_ARCHIVES_DOWNLOAD_DIR="~/Library/Mobile Documents/com~apple~CloudDocs/Genealogy"
