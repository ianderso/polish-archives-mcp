# Settings. .env holds local overrides; .env.example is the committed template.
.env
.env.*
!.env.example
.envrc

# Response cache
.cache/

# Downloaded scans are never part of this repository. The one recorded test
# image (the photo host's "file unavailable" picture) is the exception.
*.jpg
!tests/fixtures/*.jpg
*.jpeg
*.png
*.tif
*.tiff
*.pdf

# Python
__pycache__/
*.py[cod]
.venv/
venv/
build/
dist/
*.egg-info/

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editors and OS
.vscode/
.idea/
.DS_Store
